{
  "manifest_version": 3,
  "name": "ChatGPT Em Dash Remover",
  "version": "1.0.0",
  "description": "Removes em dashes from ChatGPT responses when copying",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Enhanced Copy"
  }
}
